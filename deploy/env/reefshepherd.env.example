# Copy to /etc/reefshepherd/reefshepherd.env (systemd) or pass with --config.
# Precedence: command-line flag, then environment variable, then this file, then the default.

# Address and port to listen on.
#REEFSHEPHERD_LISTEN=:8484

# Data directory (default: $STATE_DIRECTORY when systemd sets it, else ./data).
#REEFSHEPHERD_DATA_DIR=/var/lib/reefshepherd

# External URL, used for links in notifications and to mark cookies Secure.
#REEFSHEPHERD_PUBLIC_URL=https://reef.home.lan

# Comma-separated networks whose X-Forwarded-For and X-Forwarded-Proto headers are believed.
#REEFSHEPHERD_TRUSTED_PROXIES=127.0.0.1/32,192.168.1.0/24

# Comma-separated extra origins allowed to make cross-origin requests that change data (the origin of REEFSHEPHERD_PUBLIC_URL is always allowed).
#REEFSHEPHERD_TRUSTED_ORIGINS=

# Logging: level is debug, info, warn or error; format is text or json.
#REEFSHEPHERD_LOG_LEVEL=info
#REEFSHEPHERD_LOG_FORMAT=text

# Optional override of the login mode (password or disabled); wins over the web setting.
#REEFSHEPHERD_AUTH_MODE=

# Optional override of the update check (true or false); wins over the web setting.
#REEFSHEPHERD_UPDATE_CHECK=
