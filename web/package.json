{
  "name": "reefshepherd-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 5173 --strictPort",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').writeFileSync('../internal/webui/dist/.gitkeep','')\"",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run i18n && vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/plugin-message-format": "^4.5.5",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "svelte-dnd-action": "^0.9.80",
    "uplot": "^1.6.32"
  }
}
